{
  "hosting": {
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/jain-culinary-guide",
        "destination": "/special.html"
      },
      {
        "source": "/inventory",
        "destination": "/inventory.html"
      },
      {
        "source": "/recipes",
        "destination": "/recipes.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
